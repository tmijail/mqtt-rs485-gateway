# [variant] Issue #261: the QEMU build with the two functions that no build for the board has (decision of
# #133: they stay in main, only in the QEMU build, for the optional owner profile of #255).
# Applied after sdkconfig.qemu and sdkconfig.qemu-psram (tools/e2e/run_e2e.sh with E2E_SECURE=1,
# build dir build-qemu-psram-secure). The E2E runs only the scenarios of these two functions on
# it (scenarios.py, SECURE_VARIANT_SCENARIOS); all other scenarios run on the configuration of the
# board. Never flash this build.
#
# CFG-7: NVS encryption with an HMAC key in eFuse KEY5, on the emulated HMAC peripheral and
# eFuse file of each run (nothing real is burned). With it, the migration code of an unencrypted
# NVS (issues #67, #94).
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_HMAC=y
CONFIG_NVS_SEC_HMAC_EFUSE_KEY_ID=5
# FW-2: OTA images must carry a valid RSA-3072 signature (Secure Boot V2 format), without
# hardware Secure Boot: esp_ota_end() verifies them with the key taken from the running app
# instead of eFuse. Nothing is burned. The test key is generated by run_e2e.sh in build-qemu/
# (never committed).
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="build-qemu/e2e_signing_key.pem"
