# Issues #63 and #85: the QEMU build with the board's octal PSRAM (applied after
# sdkconfig.qemu, which turns it off). QEMU emulates it with
# -global driver=ssi_psram,property=is_octal,value=true (tools/e2e/run_e2e.sh with E2E_PSRAM=1
# passes it, like IDF's qemu_ext.py does).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# Issue #85: QEMU's GDMA only reaches internal RAM (espressif/qemu#180), so the SHA and AES
# accelerators in DMA mode get nothing from a buffer in PSRAM, where mbedTLS allocates when there
# is PSRAM: the first TLS handshake (HTTPS or MQTT) hangs. The emulator build uses software SHA
# and AES; the board keeps the accelerators.
CONFIG_MBEDTLS_HARDWARE_SHA=n
CONFIG_MBEDTLS_HARDWARE_AES=n
# Issue #110: the emulated open_eth MAC has 4 RX DMA buffers by default (1 600 B each). Under the
# E2E's full-speed uploads slirp's bursts overflow them ("RX frame dropped (0x14)"); a dropped
# SYN is retransmitted by slirp only after a backoff, and the harness client's 15 s timeout ran
# out first (a connection that "never reached httpd"). 10, the default of the S3's own EMAC
# driver. Only in this variant, where it was seen and internal RAM is plentiful: in the build
# without PSRAM the 9.6 KB more cut the largest free block at the #80 validation from about
# 29 KB to 18 KB, 1 KB above its threshold, and would skew that measurement. QEMU only: the
# board's W5500 has its own 16 KB of RX buffer.
CONFIG_ETH_OPENETH_DMA_RX_BUFFER_NUM=10
# Issue #124: the spill to the card needs the PSRAM, so only this variant runs it (GW23). The
# store & forward ring has 1000 samples here (the board: 40000, 960 KB), so that an outage of
# 40 s in the E2E fills it to three quarters and it spills blocks to the LittleFS stand-in.
CONFIG_GW_SF_PSRAM_SAMPLES=1000
