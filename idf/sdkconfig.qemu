# Overlay for the QEMU end-to-end test (tools/e2e/run_e2e.py). The emulator has no
# W5500, I2C expander, GPIO inputs or RMT, and it does not model: QIO flash reads by the
# app (data shifted by 2 bytes) and the RS485 half-duplex UART mode (uart_wait_tx_done
# asserts) and has no Wi-Fi radio. The octal PSRAM is in sdkconfig.qemu-psram (E2E_PSRAM=1,
# issue #85); this build runs without it.
# Never flash this build.
CONFIG_GW_ETH_OPENETH=y
CONFIG_GW_IO_SIMULATED=y
CONFIG_GW_RS485_HW_HALF_DUPLEX=n
CONFIG_SPIRAM=n
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_GW_WIFI=n
# CFG-7: the production NVS encryption, on the emulated HMAC peripheral and eFuse file of each
# run (nothing real is burned), so the E2E exercises it
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_HMAC=y
CONFIG_NVS_SEC_HMAC_EFUSE_KEY_ID=5
# QEMU writes the flash image asynchronously: a reset right after the panic handler saved the
# core dump can drop its last write (the checksum) from the image. One second lets it land.
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=1
# Issue #59: the E2E slow link (700 B/s through a relay) must exceed the publish budget with
# payloads of at most 6 KB once slirp's buffers are full; 2 s does, the default 8 s would not
CONFIG_GW_MQTT_PUBLISH_BUDGET_MS=2000
# SPB-14: QEMU has no SDMMC: the store & forward spill goes to a LittleFS directory instead
CONFIG_GW_SF_SPILL_LITTLEFS=y
