# nanopb options for Eclipse Tahu sparkplug_b.proto (proto file kept unmodified).
# Repeated and recursive parts are callbacks (streamed, nothing proportional to their size
# is allocated); fixed-size strings and bytes bound what a command may carry.
sparkplug_b.proto                    mangle_names:M_STRIP_PACKAGE
Payload.uuid                       type:FT_IGNORE
Payload.body                       type:FT_IGNORE
Payload.metrics                    type:FT_CALLBACK
Payload.Metric.name                max_size:64
Payload.Metric.metadata            type:FT_IGNORE
Payload.Metric.properties          type:FT_CALLBACK
Payload.Metric.string_value        max_size:257   # issue #87: 256 characters
Payload.Metric.bytes_value         max_size:64
Payload.Metric.dataset_value       submsg_callback:true
Payload.Metric.template_value      submsg_callback:true
Payload.Metric.extension_value     type:FT_IGNORE
Payload.Metric.MetricValueExtension skip_message:true
# SPB-16 metric properties
Payload.PropertySet.keys           type:FT_CALLBACK
Payload.PropertySet.values         type:FT_CALLBACK
Payload.PropertyValue.string_value max_size:64
Payload.PropertyValue.propertyset_value  type:FT_IGNORE
Payload.PropertyValue.propertysets_value type:FT_IGNORE
Payload.PropertyValue.extension_value    type:FT_IGNORE
Payload.PropertyValue.PropertyValueExtension skip_message:true
Payload.PropertySetList            skip_message:true
Payload.MetaData                   skip_message:true
# SPB-19 DataSet
Payload.DataSet.columns            type:FT_CALLBACK
Payload.DataSet.types              type:FT_CALLBACK
Payload.DataSet.rows               type:FT_CALLBACK
Payload.DataSet.Row.elements       type:FT_CALLBACK
Payload.DataSet.DataSetValue.string_value    max_size:64
Payload.DataSet.DataSetValue.extension_value type:FT_IGNORE
Payload.DataSet.DataSetValue.DataSetValueExtension skip_message:true
# SPB-18 Template (members are metrics: a callback breaks the recursion)
Payload.Template.version           type:FT_IGNORE
Payload.Template.metrics           type:FT_CALLBACK
Payload.Template.parameters        type:FT_IGNORE
Payload.Template.template_ref      max_size:40
Payload.Template.Parameter         skip_message:true
Payload.Template.Parameter.*       skip_message:true
