menu "Gateway: board I/O"

    config GW_IO_SIMULATED
        bool "Simulated local I/O (emulator only)"
        default n
        help
            Replaces the GPIO inputs, the I2C output expander and the RGB LED by RAM
            models so the firmware runs under QEMU. DI levels are then set from the
            console shell with "di <1-8> <0|1>". Never enable on hardware.

    config GW_DI_SAMPLE_US
        int "DI sampling period (us)"
        range 250 1000
        default 1000

    config GW_LOCAL_IO_TASK_PRIORITY
        int "Local I/O task priority"
        default 9
        help
            The local_io task is the only writer of the DO expander: DO commands (NCMD),
            the safe state (IO-3) and the local rules (IO-7).

    config GW_LED_BRIGHTNESS
        int "Status LED brightness (0-255)"
        range 1 255
        default 40

endmenu
