menu "Gateway: Sparkplug / MQTT"

    config GW_EDGE_TASK_PRIORITY
        int "Sparkplug task priority"
        default 8

    config GW_EDGE_TASK_CORE
        int "Sparkplug task core"
        range 0 1
        default 0

    config GW_EDGE_QUEUE_LEN
        int "Sparkplug task event queue length"
        range 8 64
        default 24

    config GW_CMD_SLOTS
        int "Inbound NCMD/DCMD buffers"
        range 1 16
        default 4

    config GW_CMD_MAX_PAYLOAD
        int "Largest inbound NCMD/DCMD payload (bytes)"
        range 128 4096
        default 1024

    config GW_MQTT_BUFFER_SIZE
        int "esp-mqtt send/receive buffer (bytes)"
        default 2048

    config GW_MQTT_OUTBOX_LIMIT
        int "esp-mqtt outbox limit (bytes, QoS>0 messages awaiting ACK)"
        default 8192

    config GW_MQTT_PUBLISH_BUDGET_MS
        int "Longest a single MQTT publish may take (ms)"
        range 1000 9000
        default 8000
        help
            Issue #59: esp-mqtt keeps writing a message while every socket write makes
            progress, so on a very slow link one publish (a DBIRTH of up to 6 KB) could
            outlast the task watchdog. After this long the connection is closed (the
            Sparkplug session restarts with backoff). The write in progress may still take
            up to the 5 s socket timeout: keep budget + 5 s below the 15 s watchdog.

    config GW_MQTT_BACKOFF_MIN_MS
        int "Reconnect backoff minimum (ms)"
        default 1000

    config GW_MQTT_BACKOFF_MAX_MS
        int "Reconnect backoff maximum (ms)"
        default 60000

    config GW_SNTP_WAIT_MS
        int "Wait for SNTP before the first MQTT connection (ms)"
        range 0 30000
        default 3000
        help
            Births carry better timestamps if the clock is set first. The connection
            proceeds without synchronised time once this expires.

    config GW_SF_PSRAM_SAMPLES
        int "Store & forward: samples kept in PSRAM (24 B each)"
        range 1000 400000
        default 40000
        help
            SPB-14, with sparkplug.store_forward: changes made while there is no Sparkplug
            session are kept in a ring of this many metric samples, allocated once at boot
            in PSRAM (40000 = 960 KB). When full, the oldest samples are overwritten.

    config GW_SF_INTERNAL_SAMPLES
        int "Store & forward: samples kept without PSRAM (24 B each)"
        range 64 8192
        default 512
        help
            The same ring in internal RAM when the board has no PSRAM (or it was not
            detected, or QEMU): 512 samples = 12 KB.

endmenu
