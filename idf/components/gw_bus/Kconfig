menu "Gateway: Modbus bus task"

    config GW_BUS_TASK_PRIORITY
        int "RS485 owner task priority"
        default 10

    config GW_BUS_TASK_CORE
        int "RS485 owner task core"
        range 0 1
        default 1
        help
            Core 1 keeps bus timing away from the network stack (lwIP, esp_eth, MQTT on core 0).

    config GW_BUS_WRITE_QUEUE_LEN
        int "Pending DCMD writes"
        range 1 32
        default 8

    config GW_MB_BLOCK_READS
        bool "Merge adjacent tags into block reads (MB-11)"
        default y
        help
            Default for devices without "block_reads" in the configuration.

    config GW_MB_BLOCK_MAX_GAP
        int "Largest unused register/bit gap bridged by a block read"
        range 0 32
        default 0
        depends on GW_MB_BLOCK_READS
        help
            Default for devices without "max_gap" in the configuration.

    config GW_MB_OFFLINE_PROBE_MAX_MS
        int "Longest interval between probes of an offline device (ms)"
        range 0 600000
        default 10000
        help
            An offline device is probed with a single attempt (no retries) at 2, 4, 8 ...
            times its poll_ms, up to this value (never less often than poll_ms), so a
            dead slave does not take the bus from the healthy ones. A device that answers
            again is back online (DBIRTH) at most this long plus one poll cycle later.

    config GW_MB_FORCE_MULTI_WRITE
        bool "Always write with FC15/FC16 (for slaves without FC05/FC06)"
        default n

endmenu
