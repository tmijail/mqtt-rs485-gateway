menu "Gateway: network"

    choice GW_ETH_BACKEND
        prompt "Ethernet MAC"
        default GW_ETH_W5500

        config GW_ETH_W5500
            bool "WIZnet W5500 over SPI (board; pins in gw_bsp)"

        config GW_ETH_OPENETH
            bool "OpenCores Ethernet (QEMU only)"
            select ETH_USE_OPENETH
    endchoice

    config GW_WIFI
        bool "Wi-Fi station as alternative or backup of Ethernet (NET-4)"
        depends on SOC_WIFI_SUPPORTED
        default y
        help
            Compiles the Wi-Fi station driver. It is only started when the configuration
            enables network.wifi; Ethernet-only configurations behave as without it.
            QEMU does not emulate the radio: the emulator build disables this.

endmenu
