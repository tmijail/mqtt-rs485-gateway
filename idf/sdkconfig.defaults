# Waveshare ESP32-S3-POE-ETH-8DI-8DO (ESP32-S3-WROOM-1U-N16R8)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# REL-1: task watchdog on the critical tasks (they subscribe themselves) and on the idle tasks
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
# Core dump to the "coredump" partition, read with `idf.py coredump-info`. ELF is the only
# format since IDF 6.0 (CONFIG_ESP_COREDUMP_DATA_FORMAT_* no longer exist; see the 6.0
# migration guide, system.rst).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# TIME-1: query the NTP server as soon as an address is available (the default RFC 4330
# random start-up delay of up to 5 s regularly pushes the first sync past the first NBIRTH)
CONFIG_LWIP_SNTP_STARTUP_DELAY=n

# MB-2: in RS485 half-duplex mode the UART driver releases RTS (the transceiver's DE) in the
# TX_DONE interrupt. With the ISR in flash it is deferred while the cache is disabled (the NVS
# commit of the bdSeq on every MQTT attempt), DE stays active while the slave answers and the
# response is lost.
CONFIG_UART_ISR_IN_IRAM=y

# Network stack on core 0, away from the RS485 bus owner on core 1 (gw_bus): lwIP's tcpip
# task and the esp-mqtt task (the Ethernet RX task is pinned by gw_net, the default event
# loop already runs on core 0).
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_MQTT_TASK_CORE_SELECTION_ENABLED=y
CONFIG_MQTT_USE_CORE_0=y

# REL-3
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# MQTT-7: never queue QoS>0 messages while disconnected (the outbox is also size-limited)
CONFIG_MQTT_SKIP_PUBLISH_IF_DISCONNECTED=y

# NET-4: Wi-Fi station as backup of Ethernet. Keep the Wi-Fi driver's buffers and lwIP
# allocations in PSRAM when possible, and its code in flash (internal RAM is the scarce one)
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# DNS servers follow the interface that carries the default route (lwIP keeps one global list)
CONFIG_ESP_NETIF_SET_DNS_PER_DEFAULT_NETIF=y
# NET-7: SLAAC compiled in; each interface turns it on only with network.ipv6 enabled
CONFIG_LWIP_IPV6_AUTOCONFIG=y

# MQTT-4: TLS 1.2 and 1.3 towards the broker. The certificate dates are checked (the connection
# waits for SNTP); a session's ~40 KB of mbedTLS heap goes to PSRAM when the board has it and to
# internal RAM otherwise (custom allocator set in gw_storage_init). The bundle of public root CAs
# (used when mqtt.tls.ca_file is empty) is the common subset, not the full list.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_MBEDTLS_CUSTOM_MEM_ALLOC=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y

# MQTT-8: MQTT 5.0 compiled in; mqtt.protocol chooses it per device (3.1.1 by default)
CONFIG_MQTT_PROTOCOL_5=y

# Issue #64: the web UI and the REST API over HTTPS, with a certificate generated by the device
# at its first boot (X.509 writing); plain HTTP only redirects
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_MBEDTLS_X509_CREATE_C=y
# two web servers (HTTPS and the HTTP redirect, each with a control socket), Modbus TCP (listener
# and clients), MQTT, syslog, SNTP, mDNS, DNS: 10 sockets are
# not enough (accept fails with ENFILE)
CONFIG_LWIP_MAX_SOCKETS=24

# CFG-7: NVS is NOT encrypted in this default build (no eFuse is ever burned by flashing it).
# Secrets still live in NVS, outside config.json. Production units add sdkconfig.production.
