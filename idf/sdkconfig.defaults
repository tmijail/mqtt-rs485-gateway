# Waveshare ESP32-S3-POE-ETH-8DI-8DO (ESP32-S3-WROOM-1U-N16R8)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# REL-1: task watchdog on the critical tasks (they subscribe themselves) and on the idle tasks
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
# Core dump to the "coredump" partition, read with `idf.py coredump-info`. ELF is the only
# format since IDF 6.0 (CONFIG_ESP_COREDUMP_DATA_FORMAT_* no longer exist; see the 6.0
# migration guide, system.rst).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# TIME-1: query the NTP server as soon as an address is available (the default RFC 4330
# random start-up delay of up to 5 s regularly pushes the first sync past the first NBIRTH)
CONFIG_LWIP_SNTP_STARTUP_DELAY=n

# MB-2: in RS485 half-duplex mode the UART driver releases RTS (the transceiver's DE) in the
# TX_DONE interrupt. With the ISR in flash it is deferred while the cache is disabled (the NVS
# commit of the bdSeq on every MQTT attempt), DE stays active while the slave answers and the
# response is lost.
CONFIG_UART_ISR_IN_IRAM=y

# REL-3
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# MQTT-7: never queue QoS>0 messages while disconnected (the outbox is also size-limited)
CONFIG_MQTT_SKIP_PUBLISH_IF_DISCONNECTED=y
