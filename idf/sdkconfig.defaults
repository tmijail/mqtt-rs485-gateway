# Waveshare ESP32-S3-POE-ETH-8DI-8DO (ESP32-S3-WROOM-1U-N16R8)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# REL-1: task watchdog on the critical tasks (they subscribe themselves) and on the idle tasks
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# TIME-1: query the NTP server as soon as an address is available (the default RFC 4330
# random start-up delay of up to 5 s regularly pushes the first sync past the first NBIRTH)
CONFIG_LWIP_SNTP_STARTUP_DELAY=n

# REL-3
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# MQTT-7: never queue QoS>0 messages while disconnected (the outbox is also size-limited)
CONFIG_MQTT_SKIP_PUBLISH_IF_DISCONNECTED=y

# NET-4: Wi-Fi station as backup of Ethernet. Keep the Wi-Fi driver's buffers and lwIP
# allocations in PSRAM when possible, and its code in flash (internal RAM is the scarce one)
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# DNS servers follow the interface that carries the default route (lwIP keeps one global list)
CONFIG_ESP_NETIF_SET_DNS_PER_DEFAULT_NETIF=y
