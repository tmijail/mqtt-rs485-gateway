# Gateway application options, shared by the firmware and the unit tests.
# SPDX-License-Identifier: Apache-2.0

menu "RS485 to Sparkplug B gateway"

config GW_MAX_DEVICES
	int "Maximum number of Modbus devices"
	default 16
	range 1 32

config GW_MAX_TAGS_PER_DEVICE
	int "Maximum number of tags per device"
	default 64
	range 1 128

config GW_MAX_TAGS
	int "Maximum number of tags in total"
	default 256
	range 1 1024

config GW_PAYLOAD_BUF_SIZE
	int "Sparkplug encode buffer size (bytes)"
	default 8192
	help
	  Size of the single static buffer used to encode outgoing payloads.
	  It must hold a DBIRTH with GW_MAX_TAGS_PER_DEVICE metrics; the
	  encoder fails cleanly (and logs) when a payload does not fit.

config GW_MQTT_RX_PAYLOAD_SIZE
	int "Largest accepted NCMD/DCMD payload (bytes)"
	default 1024

config GW_WRITE_QUEUE_LEN
	int "Depth of the DCMD write queue towards the RS485 bus owner"
	default 16

config GW_SNTP_RESYNC_S
	int "SNTP resynchronisation period (seconds)"
	default 3600

config GW_SNTP_TIMEOUT_MS
	int "SNTP query timeout (ms)"
	default 3000

config GW_CONFIG_PATH
	string "Path of the configuration override file"
	default "/lfs/config.json"

config GW_CONFIG_MAX_SIZE
	int "Largest accepted configuration file (bytes)"
	default 32768

config GW_HARDWARE_NAME
	string "Hardware description published in Node Info/Hardware"
	default "Waveshare ESP32-S3-POE-ETH-8DI-8DO"

config GW_WDT_TIMEOUT_MS
	int "Task watchdog timeout for the gateway threads (ms)"
	default 30000

config GW_STATUS_LED
	bool "Drive the RGB status LED"
	default y
	depends on LED_STRIP

module = GW
module-str = gateway
source "subsys/logging/Kconfig.template.log_config"

endmenu
