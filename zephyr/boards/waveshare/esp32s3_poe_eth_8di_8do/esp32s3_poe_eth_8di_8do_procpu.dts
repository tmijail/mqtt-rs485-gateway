/*
 * Waveshare ESP32-S3-POE-ETH-8DI-8DO, PRO CPU.
 *
 * Facts confirmed from the Waveshare wiki and its Arduino demo code
 * (ESP32-S3-POE-ETH-8DI-8DO-Demo.zip): see zephyr/README.md, section
 * "Datos de la placa", for the evidence and the confidence level.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

/dts-v1/;

#include <espressif/esp32s3/esp32s3.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/led/led.h>
#include "esp32s3_poe_eth_8di_8do_partitions.dtsi"
#include "esp32s3_poe_eth_8di_8do-pinctrl.dtsi"

/ {
	model = "Waveshare ESP32-S3-POE-ETH-8DI-8DO PROCPU";
	compatible = "waveshare,esp32s3-poe-eth-8di-8do";

	aliases {
		watchdog0 = &wdt0;
		sw0 = &button_boot;
		status-led = &rgb_led;
		rtc = &rtc;
	};

	chosen {
		zephyr,sram = &sram1;
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,settings-partition = &storage_partition;
		zephyr,canbus = &twai;
	};

	buttons {
		compatible = "gpio-keys";

		button_boot: button_boot {
			gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "BOOT";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	/*
	 * Field I/O for applications (there is no generic binding for plain
	 * digital I/O channels).
	 *
	 * di-gpios: opto-isolated inputs DI1..DI8 = GPIO4..GPIO11. The pin is
	 * pulled up and the energised optocoupler pulls it low: active low.
	 *
	 * do-gpios: Darlington sink outputs DO1..DO8 = TCA9554 EXIO1..EXIO8.
	 * A low expander pin turns the output on: active low.
	 */
	zephyr,user {
		di-gpios = <&gpio0 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			   <&gpio0 5 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			   <&gpio0 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			   <&gpio0 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			   <&gpio0 8 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			   <&gpio0 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			   <&gpio0 10 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			   <&gpio0 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		do-gpios = <&exio 0 GPIO_ACTIVE_LOW>, <&exio 1 GPIO_ACTIVE_LOW>,
			   <&exio 2 GPIO_ACTIVE_LOW>, <&exio 3 GPIO_ACTIVE_LOW>,
			   <&exio 4 GPIO_ACTIVE_LOW>, <&exio 5 GPIO_ACTIVE_LOW>,
			   <&exio 6 GPIO_ACTIVE_LOW>, <&exio 7 GPIO_ACTIVE_LOW>;
	};

	/* RGB status LED on GPIO38; the demo sends the bytes in R, G, B order. */
	rgb_led: rgb-led {
		compatible = "worldsemi,ws2812-pulse-io";
		pulse-ios = <&rmt 0>;
		chain-length = <1>;
		color-mapping = <LED_COLOR_ID_RED LED_COLOR_ID_GREEN LED_COLOR_ID_BLUE>;
	};
};

&psram0 {
	size = <DT_SIZE_M(8)>;
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&usb_serial {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&trng0 {
	status = "okay";
};

&rmt {
	pinctrl-0 = <&rmt_led>;
	pinctrl-names = "default";
	status = "okay";
};

/* Isolated RS485 transceiver on UART1, DE/RTS on GPIO21 (active high). */
&uart1 {
	status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&uart1_rs485>;
	pinctrl-names = "default";

	rs485_modbus: rs485-modbus {
		compatible = "zephyr,modbus-serial";
		status = "okay";
		de-gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
	};
};

/* W5500 Ethernet controller (MACRAW mode with the Zephyr IP stack). */
&spi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&spim2_w5500>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;

	w5500: ethernet@0 {
		compatible = "wiznet,w5500";
		reg = <0x0>;
		spi-max-frequency = <20000000>;
		int-gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpio1 7 GPIO_ACTIVE_LOW>; /* GPIO39 */
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";

	/* TCA9554 EXIO1..8 -> DO1..DO8. A low pin turns the Darlington on. */
	exio: gpio@20 {
		compatible = "ti,tca9554";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;
	};

	rtc: rtc@51 {
		compatible = "nxp,pcf85063a";
		reg = <0x51>;
		int1-gpios = <&gpio1 8 GPIO_ACTIVE_LOW>; /* GPIO40 */
		status = "disabled"; /* TIME-2 is not part of the MVP */
	};
};

/* Passive buzzer (PWM), not used by the MVP. */
&ledc0 {
	pinctrl-0 = <&ledc0_buzzer>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;
	status = "disabled";

	channel0@0 {
		reg = <0x0>;
		timer = <0>;
	};
};

&twai {
	pinctrl-0 = <&twai_default>;
	pinctrl-names = "default";
	status = "disabled"; /* CAN is not part of the product spec */
};

/* microSD: 1-bit SD bus, CLK 48, CMD 47, D0 45 (D1..D3 not connected). */
&sdhc {
	status = "disabled";
};

&sdhc1 {
	status = "disabled";
	bus-width = <1>;
	clk-pin = <48>;
	cmd-pin = <47>;
	d0-pin = <45>;
};
